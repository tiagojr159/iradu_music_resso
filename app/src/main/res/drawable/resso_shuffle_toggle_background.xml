<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="#4DFF0A7A" />
            <stroke
                android:width="1dp"
                android:color="#FFFF4DA3" />
            <padding
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="2dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="#4DFF0A7A" />
            <stroke
                android:width="1dp"
                android:color="#FFFF4DA3" />
            <padding
                android:bottom="1dp"
                android:left="1dp"
                android:right="1dp"
                android:top="2dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="#33FF0A7A" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="18dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
