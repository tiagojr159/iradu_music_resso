<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="230dp"
    android:layout_height="120dp"
    android:layout_marginEnd="14dp"
    android:background="@drawable/resso_surface_panel"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/music_card_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/music_card_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:maxLines="2"
            android:textColor="#B8B4C7"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/music_card_image"
        android:layout_width="78dp"
        android:layout_height="78dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/resso_card_background"
        android:scaleType="centerCrop" />
</LinearLayout>
